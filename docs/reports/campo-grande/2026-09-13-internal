<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow,noarchive">
<meta name="referrer" content="no-referrer">
<title>Savant Syndicate</title>
<style>
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:#252220;color:#F5F1E8;
 font:15px/1.6 "Segoe UI",-apple-system,Helvetica,Arial,sans-serif;
 display:flex;align-items:center;justify-content:center;padding:24px}
.card{width:100%;max-width:430px;background:#2E2B27;border:1px solid #45413C;
 border-radius:6px;padding:38px 34px 32px}
.brand{font:600 11px/1 "Segoe UI",-apple-system,Helvetica,Arial,sans-serif;
 letter-spacing:.22em;text-transform:uppercase;color:#D4A438}
h1{font:600 27px/1.2 Georgia,"Times New Roman",serif;margin:18px 0 10px;color:#F5F1E8}
.rule{height:1px;background:#D4A438;width:56px;margin:0 0 18px}
p{margin:0 0 20px;color:#C9C5BC;font-size:14px}
label{display:block;font:600 10px/1 "Segoe UI",-apple-system,Helvetica,Arial,sans-serif;
 letter-spacing:.16em;text-transform:uppercase;color:#A8A29A;margin-bottom:8px}
input{width:100%;padding:11px 13px;background:#252220;color:#F5F1E8;
 border:1px solid #45413C;border-radius:4px;font-size:15px;font-family:inherit}
input:focus{outline:2px solid #D4A438;outline-offset:1px;border-color:#D4A438}
button{width:100%;margin-top:14px;padding:11px 13px;background:#D4A438;color:#3A2B10;
 border:0;border-radius:4px;font:700 13px/1 "Segoe UI",-apple-system,Helvetica,Arial,sans-serif;
 letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
button:hover{background:#E0B44F}
button[disabled]{opacity:.6;cursor:default}
.msg{margin-top:16px;font-size:13px;min-height:19px;color:#A8A29A}
.msg.err{color:#F0B3B3}
.foot{margin-top:26px;padding-top:16px;border-top:1px solid #45413C;
 font-size:11.5px;color:#8E877E}
noscript{display:block;margin-top:16px;color:#F0B3B3;font-size:13px}
</style></head><body>
<main class="card">
  <div class="brand">Savant Syndicate</div>
  <h1>Protected document</h1>
  <div class="rule"></div>
  <p>This document is encrypted. Enter the passcode you were given to open it.
     Decryption happens in this browser; the passcode is never sent anywhere.</p>
  <form id="f" autocomplete="off">
    <label for="p">Passcode</label>
    <input id="p" type="password" autocomplete="off" autocapitalize="off"
           autocorrect="off" spellcheck="false" required>
    <button id="b" type="submit">Open</button>
  </form>
  <div class="msg" id="m" role="status" aria-live="polite"></div>
  <noscript>This document needs JavaScript to decrypt in your browser.</noscript>
  <div class="foot">AES-256-GCM · PBKDF2-HMAC-SHA256, 600,000 iterations</div>
</main>
<script id="payload" type="application/json">{"v":1,"alg":"AES-256-GCM","kdf":"PBKDF2-HMAC-SHA256","iterations":600000,"salt":"a909up1o3rsxaWlG6tuWLw==","iv":"Mk02U40Vraq/i8eF","ct":""}</script>
<script>
(function () {
  var D = JSON.parse(document.getElementById("payload").textContent);
  var f = document.getElementById("f"), p = document.getElementById("p"),
      b = document.getElementById("b"), m = document.getElementById("m");

  function b64(s) {
    var raw = atob(s), a = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) a[i] = raw.charCodeAt(i);
    return a;
  }
  function say(text, isErr) { m.textContent = text; m.className = isErr ? "msg err" : "msg"; }

  if (!(window.crypto && window.crypto.subtle)) {
    say("This browser cannot decrypt the document. Open it over https, in a current browser.", true);
    b.disabled = true;
    return;
  }

  f.addEventListener("submit", function (e) {
    e.preventDefault();
    var pass = p.value;
    if (!pass) return;
    b.disabled = true;
    say("Decrypting\u2026", false);

    crypto.subtle.importKey("raw", new TextEncoder().encode(pass), "PBKDF2", false, ["deriveKey"])
      .then(function (base) {
        return crypto.subtle.deriveKey(
          { name: "PBKDF2", salt: b64(D.salt), iterations: D.iterations, hash: "SHA-256" },
          base, { name: "AES-GCM", length: 256 }, false, ["decrypt"]
        );
      })
      .then(function (key) {
        return crypto.subtle.decrypt({ name: "AES-GCM", iv: b64(D.iv) }, key, b64(D.ct));
      })
      .then(function (buf) {
        var doc = new TextDecoder("utf-8").decode(buf);
        document.open("text/html");
        document.write(doc);
        document.close();
      })
      .catch(function () {
        // GCM authentication failed. The only cause a reader can act on is a
        // wrong passcode; a tampered file fails identically and by design.
        b.disabled = false;
        p.value = "";
        p.focus();
        say("That passcode did not open this document. Check it and try again.", true);
      });
  });
  p.focus();
})();
</script>
</body></html>
